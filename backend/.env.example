# Copy this file to .env and fill in your API keys
# The frontend can also pass keys directly in the payload (for demo use only)

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=...

# Azure OpenAI (use model format: azure/<your-deployment-name>)
AZURE_API_KEY=...
AZURE_API_BASE=https://your-resource-name.openai.azure.com/
AZURE_API_VERSION=2024-02-01
